{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opt-in PDF preflight policy (PDF points, physical pages)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "page_count": {"type": "integer", "minimum": 1},
    "width_pt": {"type": "number", "exclusiveMinimum": 0},
    "height_pt": {"type": "number", "exclusiveMinimum": 0},
    "tolerance_pt": {"type": "number", "minimum": 0, "default": 0.01},
    "require_embedded_fonts": {"type": "boolean", "default": false},
    "min_font_pt": {"type": "number", "exclusiveMinimum": 0},
    "min_stroke_pt": {"type": "number", "exclusiveMinimum": 0},
    "text_safe_margin_pt": {"type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "number", "minimum": 0}},
    "allowed_blank_pages": {"type": "array", "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}},
    "require_grayscale": {"type": "boolean"},
    "raster_dpi": {"type": "integer", "minimum": 36, "maximum": 600},
    "ink_threshold": {"type": "integer", "minimum": 1, "maximum": 255},
    "color_tolerance": {"type": "integer", "minimum": 0, "maximum": 255},
    "content_expectations": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "page", "text"],
      "properties": {"id": {"type": "string"}, "page": {"type": "integer", "minimum": 1},
                     "text": {"type": "string", "minLength": 1},
                     "count": {"type": "integer", "minimum": 0}}
    }}
  },
  "dependentRequired": {
    "width_pt": ["height_pt"],
    "height_pt": ["width_pt"]
  }
}
