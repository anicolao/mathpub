{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "id", "kind", "title", "profile"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string"},
    "kind": {"enum": ["test", "worksheet", "textbook", "presentation"]},
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "course": {"type": "string"},
    "author": {"type": "string"},
    "profile": {"type": "string"},
    "paper": {"enum": ["letter", "a4"]},
    "font": {"enum": ["concrete", "libertinus", "computer-modern"]},
    "style": {"type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"},
    "theme": {"enum": ["metropolis"]},
    "aspect_ratio": {"enum": ["169", "43"]},
    "projections": {"type": "array", "items": {"enum": ["student", "answers", "solutions", "validation", "parent"]}, "uniqueItems": true},
    "student_fields": {"type": "object"},
    "instructions": {"type": "object"},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["questions"]}},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "source"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "source": {"type": "string"},
          "plain": {"type": "boolean"},
          "fragile": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "component_chapters": {
      "description": "Required source model for textbooks: reviewable content is assembled from catalog components with source mapping.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "lessons"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "concepts", "blocks"],
              "properties": {
                "id": {"type": "string"},
                "number": {"type": "string"},
                "heading": {"type": "string"},
                "title": {"type": "string"},
                "concepts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string"},
                  "uniqueItems": true
                },
                "objectives": {
                  "type": "array",
                  "items": {"type": "string"},
                  "uniqueItems": true
                },
                "blocks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "heading": {"type": "string"},
                      "page_break_before": {"type": "boolean"},
                      "include": {"type": "string"},
                      "placement": {"type": "string"},
                      "derive": {
                        "enum": ["objectives", "common-errors", "concept-summary", "teaching-tips"]
                      },
                      "title": {"type": "string"},
                      "audience": {"enum": ["student", "parent", "teacher", "general"]},
                      "overrides": {"type": "object"},
                      "problem_set": {
                        "type": "object",
                        "required": ["id", "title"],
                        "properties": {
                          "id": {"type": "string"},
                          "number": {"type": "string"},
                          "title": {"type": "string"},
                          "show_title": {"type": "boolean"},
                          "answer_title": {"type": "string"},
                          "directions": {"type": "string"},
                          "direction_lines": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "object",
                              "required": ["text"],
                              "properties": {
                                "label": {"type": "string"},
                                "text": {"type": "string"}
                              },
                              "additionalProperties": false
                            }
                          },
                          "page_break_before": {"type": "boolean"},
                          "answer_page_break_before": {"type": "boolean"},
                          "self_assessment": {"type": "string"},
                          "self_assessment_placement": {"type": "string"},
                          "self_assessment_page_break_before": {"type": "boolean"},
                          "questions": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "object",
                              "required": ["id", "placement"],
                              "properties": {
                                "id": {"type": "string"},
                                "placement": {"type": "string"},
                                "overrides": {"type": "object"},
                                "workspace": {"type": "string"},
                                "emphasize_answer": {"type": "boolean"},
                                "response": {"enum": ["workspace", "truth-blank", "answer-line"]},
                                "page_break_before": {"type": "boolean"}
                              },
                              "additionalProperties": false
                            }
                          },
                          "parts": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "object",
                              "required": ["id", "title", "questions"],
                              "properties": {
                                "id": {"type": "string"},
                                "title": {"type": "string"},
                                "answer_title": {"type": "string"},
                                "directions": {"type": "string"},
                                "direction_lines": {
                                  "type": "array",
                                  "minItems": 1,
                                  "items": {
                                    "type": "object",
                                    "required": ["text"],
                                    "properties": {
                                      "label": {"type": "string"},
                                      "text": {"type": "string"}
                                    },
                                    "additionalProperties": false
                                  }
                                },
                                "response": {"enum": ["workspace", "truth-blank", "answer-line"]},
                                "workspace": {"type": "string"},
                                "emphasize_answers": {"type": "boolean"},
                                "page_break_before": {"type": "boolean"},
                                "answer_page_break_before": {"type": "boolean"},
                                "questions": {
                                  "type": "array",
                                  "minItems": 1,
                                  "items": {
                                    "type": "object",
                                    "required": ["id", "placement"],
                                    "properties": {
                                      "id": {"type": "string"},
                                      "placement": {"type": "string"},
                                      "overrides": {"type": "object"},
                                      "workspace": {"type": "string"},
                                      "emphasize_answer": {"type": "boolean"},
                                      "response": {"enum": ["workspace", "truth-blank", "answer-line"]},
                                      "page_break_before": {"type": "boolean"}
                                    },
                                    "additionalProperties": false
                                  }
                                }
                              },
                              "additionalProperties": false
                            }
                          }
                        },
                        "additionalProperties": false,
                        "dependentRequired": {
                          "self_assessment": ["self_assessment_placement"],
                          "self_assessment_placement": ["self_assessment"]
                        },
                        "oneOf": [
                          {"required": ["questions"]},
                          {"required": ["parts"]}
                        ]
                      }
                    },
                    "additionalProperties": false,
                    "oneOf": [
                      {"required": ["heading"]},
                      {"required": ["include", "placement"]},
                      {"required": ["derive"]},
                      {"required": ["problem_set"]}
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "textbook"}}},
      "then": {
        "required": ["component_chapters"],
        "not": {
          "anyOf": [
            {"required": ["sections"]},
            {"required": ["slides"]}
          ]
        }
      },
      "else": {
        "if": {"properties": {"kind": {"const": "presentation"}}},
        "then": {
          "required": ["slides"],
          "properties": {
            "projections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {"const": "student"}
            }
          },
          "not": {
            "anyOf": [
              {"required": ["sections"]},
              {"required": ["component_chapters"]}
            ]
          }
        },
        "else": {
          "required": ["sections"],
          "not": {
            "anyOf": [
              {"required": ["component_chapters"]},
              {"required": ["slides"]}
            ]
          }
        }
      }
    }
  ]
}
