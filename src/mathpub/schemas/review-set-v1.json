{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["schema", "books"],
  "properties": {
    "schema": {"const": 1}, "label": {"type": "string"},
    "dpi": {"type": "integer", "minimum": 36, "maximum": 300},
    "books": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["label", "before", "after"],
      "properties": {
        "label": {"type": "string"}, "before": {"type": "string"}, "after": {"type": "string"},
        "notes": {"type": "string"}, "baseline_revision": {"type": "string"},
        "attachments": {"type": "array", "items": {"type": "string"}}
      }
    }}
  }
}
