{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["schema", "id", "books"],
  "properties": {
    "schema": {"const": 1}, "id": {"type": "string", "minLength": 1},
    "books": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "required_roles", "artifacts"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"},
        "required_roles": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["interior", "cover", "proof", "supplement"]}},
        "artifacts": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["role", "manifest", "projection"],
          "properties": {
            "role": {"enum": ["interior", "cover", "proof", "supplement"]},
            "manifest": {"type": "string"}, "projection": {"type": "string"},
            "receipt": {"type": "string"}
          }
        }}
      }
    }}
  }
}
