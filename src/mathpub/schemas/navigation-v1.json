{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["schema"],
  "properties": {
    "schema": {"const": 1}, "dpi": {"type": "integer", "minimum": 72, "maximum": 600},
    "qr": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "page", "payload"],
      "properties": {"id": {"type": "string"}, "page": {"type": "integer", "minimum": 1},
        "payload": {"type": "string"}, "count": {"type": "integer", "minimum": 1},
        "box_pt": {"type": "array", "minItems": 4, "maxItems": 4,
                   "items": {"type": "number", "minimum": 0}}}
    }},
    "links": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "page"],
      "oneOf": [{"required": ["uri"]}, {"required": ["destination_page"]}],
      "properties": {"id": {"type": "string"}, "page": {"type": "integer", "minimum": 1},
        "uri": {"type": "string"}, "destination_page": {"type": "integer", "minimum": 1},
        "count": {"type": "integer", "minimum": 1}}
    }},
    "bookmarks": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "page"],
      "properties": {"id": {"type": "string"}, "title": {"type": "string"},
        "page": {"type": "integer", "minimum": 1}, "text": {"type": "string"}}
    }}
  }
}
